{
  "id": "edit-preferences-route-entrypoint",
  "decision": "edit_preferences_workspace_feature_complete_except_external_blocker",
  "route": "/preferences",
  "legacyRedirect": "/edit-preferences",
  "source": {
    "page": "src/pages/PreferencesPage.tsx",
    "defaultProjectId": null,
    "defaultEditSessionId": null
  },
  "features": [
    "edit_reference_workspace",
    "study_chat",
    "preference_dna_review",
    "applied_edit_history",
    "safety_privacy_guidance",
    "clean_preference_groups",
    "preference_note_field",
    "mock_local_boundary_summary",
    "sidebar_navigation",
    "minimal_sidebar_home_project_edit_preferences_only"
  ],
  "sidebarNavigation": {
    "allowed": [
      "Home",
      "Project",
      "Edit Preferences"
    ],
    "removedFromPrimarySidebar": [
      "AI Editor",
      "Media Library",
      "Templates",
      "Team",
      "Analytics",
      "Exports",
      "Brand Kit",
      "Settings",
      "Wallet",
      "Upload"
    ],
    "retiredStandaloneRoutes": {
      "/wallet": "/dashboard",
      "/brand-kit": "/preferences",
      "/exports": "/projects"
    },
    "context": "Contextual project and edit actions can open scoped workflows, but the persistent app sidebar remains Home, Project, and Edit Preferences only."
  },
  "backendLocalCapabilities": {
    "privateReferenceUpload": true,
    "ffprobeMediaStructure": true,
    "ffmpegRepresentativeFramePlan": true,
    "ephemeralArtifactCleanup": true,
    "preferenceDnaLifecycle": true,
    "targetApplicationLifecycle": true
  },
  "blockedScope": {
    "remoteUploadOrStorage": false,
    "referenceUrlFetch": false,
    "liveQwenCall": false,
    "liveDeepseekCall": false,
    "externalProviderCall": false,
    "distributedWorkerDispatch": false,
    "renderOrExport": false,
    "creditReservationOrSpend": false,
    "supabaseReadWrite": false,
    "storageSignedUrls": false,
    "sqlOrMigration": false,
    "externalBeta": false,
    "realUserMediaBeta": false,
    "paidProduction": false,
    "productReady": false
  },
  "validation": {
    "required": [
      "smoke:edit-preferences-route-entrypoint",
      "edit-preferences-route-entrypoint.spec.ts",
      "smoke:project-edit-brief-internal-testing-entrypoint",
      "smoke:project-edit-brief-e2e",
      "smoke:beta-readiness",
      "typecheck:server",
      "build",
      "git diff --check",
      "git diff --cached --check"
    ]
  }
}
