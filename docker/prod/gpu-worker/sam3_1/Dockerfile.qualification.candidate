  && useradd \
    --uid 65532 \
    --gid 65532 \
    --no-create-home \
    --home-dir /nonexistent \
    --shell /usr/sbin/nologin \
    reeditpro

USER 65532:65532
WORKDIR /nonexistent

ENTRYPOINT ["/opt/reeditpro/sam3_1/qualification_entrypoint.sh"]
