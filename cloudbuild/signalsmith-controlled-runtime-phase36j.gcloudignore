# Phase 36J Signalsmith controlled runtime Cloud Build source bundle.
# Keep this intentionally narrow: Dockerfile, Cloud Build config, and worker
# code only. Runtime source/audio/media artifacts are fetched or generated
# inside the private Cloud Run Job.

*

!cloudbuild/
!cloudbuild/signalsmith-controlled-runtime-phase36j.yaml
!cloudbuild/signalsmith-controlled-runtime-phase36j.gcloudignore

!docker/
!docker/prod/
!docker/prod/signalsmith-controlled-runtime/
!docker/prod/signalsmith-controlled-runtime/Dockerfile.phase36j
!docker/prod/signalsmith-controlled-runtime/README.phase36j.md

!server/
!server/workers/
!server/workers/signalsmith-stretch-runtime/
!server/workers/signalsmith-stretch-runtime/**

**/.git
**/.DS_Store
**/node_modules
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/dist
**/dist-*
**/build
**/*.log
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*token*
**/*.mp4
**/*.mov
**/*.mkv
**/*.webm
**/*.wav
**/*.mp3
**/*.aac
**/*.flac
**/*.ogg
**/*.raw
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.tar.gz
**/model-weights
**/models
**/private-artifacts
**/runtime-artifacts
**/generated-*
**/controlled-*
