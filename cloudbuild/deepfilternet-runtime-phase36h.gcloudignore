# Phase 36H DeepFilterNet linux/amd64 Cloud Build source bundle.
# Keep this intentionally narrow: Dockerfile, Cloud Build config, and the
# metadata-only worker entrypoint. Runtime artifacts are copied from private GCS
# inside the Cloud Run Job after checksum verification.

*

!cloudbuild/
!cloudbuild/deepfilternet-runtime-phase36h.yaml
!cloudbuild/deepfilternet-runtime-phase36h.gcloudignore

!docker/
!docker/prod/
!docker/prod/deepfilternet-runtime/
!docker/prod/deepfilternet-runtime/Dockerfile.phase36h
!docker/prod/deepfilternet-runtime/README.phase36h.md

!server/
!server/workers/
!server/workers/deepfilternet-runtime/
!server/workers/deepfilternet-runtime/**

**/.git
**/.DS_Store
**/node_modules
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/dist
**/dist-*
**/build
**/*.log
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*token*
**/*.mp4
**/*.mov
**/*.mkv
**/*.webm
**/*.wav
**/*.mp3
**/*.aac
**/*.flac
**/*.ogg
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.tar.gz
**/model-weights
**/models
**/private-artifacts
**/runtime-artifacts
**/generated-*
