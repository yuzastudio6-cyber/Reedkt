{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reeditpro.local/schemas/pipeline-pattern.schema.v1.json",
  "title": "Reeditpro Tool-Calling Pipeline Pattern",
  "type": "object",
  "required": ["patternId", "operations"],
  "additionalProperties": false,
  "properties": {
    "patternId": {
      "type": "string",
      "enum": [
        "raw_footage_to_social_short",
        "captioned_talking_head",
        "smart_cut_basic",
        "final_export_validation"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "executionMode": {
      "type": "string",
      "const": "planning_only"
    }
  }
}
