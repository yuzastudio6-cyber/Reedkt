FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:slim

ENV CLOUDSDK_CORE_DISABLE_PROMPTS=1 \
    PYTHONUNBUFFERED=1 \
    REEDITPRO_ENV=staging

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    ffmpeg \
    git \
    python3 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY server/workers/signalsmith-stretch-runtime/ /app/server/workers/signalsmith-stretch-runtime/

ENTRYPOINT ["python3", "/app/server/workers/signalsmith-stretch-runtime/linux_controlled_entrypoint.py"]
