    | sha256sum --check --strict \
  && python -I -B -c \
    "import hashlib; from pathlib import Path; path=Path('/opt/reeditpro/sam3-source/sam3/model/sam3_multiplex_tracking.py'); body=path.read_bytes(); assert hashlib.sha256(body).hexdigest() == 'fde68920b0073ec6eea2ad63351fb1c133c9abdd866c2cb9f9d28c8a2d969038'; text=body.decode('utf-8'); signature='        offload_video_to_cpu=False,\n        async_loading_frames=False,\n        use_torchcodec=False,\n        use_cv2=False,\n        input_is_mp4=False,\n'; forwarded='            offload_video_to_cpu=offload_video_to_cpu,\n            async_loading_frames=async_loading_frames,\n            use_torchcodec=use_torchcodec,\n            use_cv2=use_cv2,\n            input_is_mp4=input_is_mp4,\n'; assert text.count(signature) == 2; assert text.count(forwarded) == 2; text=text.replace(signature, '        offload_video_to_cpu=False,\n        offload_state_to_cpu=False,\n        async_loading_frames=False,\n        use_torchcodec=False,\n        use_cv2=False,\n        input_is_mp4=False,\n        gpu_acceleration=False,\n        gpu_device=None,\n'); text=text.replace(forwarded, '            offload_video_to_cpu=offload_video_to_cpu,\n            offload_state_to_cpu=offload_state_to_cpu,\n            async_loading_frames=async_loading_frames,\n            use_torchcodec=use_torchcodec,\n            use_cv2=use_cv2,\n            input_is_mp4=input_is_mp4,\n            gpu_acceleration=gpu_acceleration,\n            gpu_device=gpu_device,\n'); output=text.encode('utf-8'); assert hashlib.sha256(output).hexdigest() == 'e9fd77f867968f0740e420971fd0405a0b511ac8684019660767f5b07d26ab41'; path.write_bytes(output)" \
