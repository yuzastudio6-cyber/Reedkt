{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reeditpro.local/schemas/tool-calling/fixture-bound-metadata-probe.v1.json",
  "title": "Reeditpro Fixture-Bound Metadata Probe Result",
  "type": "object",
  "required": [
    "probeRunId",
    "probeId",
    "toolId",
    "fixtureId",
    "fixtureKind",
    "fixtureContentType",
    "sourceGenerationRunId",
    "sourceArtifactId",
    "status",
    "startedAt",
    "completedAt",
    "durationMs",
    "executableFound",
    "fixtureInputUsed",
    "realUserMediaUsed",
    "signedUrlsUsed",
    "shellUsed",
    "arbitraryArgsUsed",
    "workerExecutionPerformed",
    "providerCallsPerformed",
    "supabaseMutationPerformed",
    "sqlExecuted",
    "packageLockMutated",
    "betaProductionUnlocked",
    "mediaProcessingPerformed",
    "metadataProbePerformed",
    "issues",
    "warnings",
    "tempWorkspaceCreated",
    "tempWorkspaceCleanedUp",
    "executesTools"
  ],
  "properties": {
    "probeRunId": { "type": "string" },
    "probeId": { "const": "ffprobe_fixture_bound_synthetic_audio_metadata_probe" },
    "toolId": { "const": "ffprobe" },
    "fixtureId": { "type": "string" },
    "fixtureKind": { "const": "synthetic_audio" },
    "fixtureContentType": { "const": "audio/wav" },
    "sourceGenerationRunId": { "type": "string" },
    "sourceArtifactId": { "type": "string" },
    "status": { "enum": ["passed", "unavailable", "failed_closed"] },
    "startedAt": { "type": "string" },
    "completedAt": { "type": "string" },
    "durationMs": { "type": "number", "minimum": 0 },
    "executableFound": { "type": "boolean" },
    "fixtureInputUsed": { "const": true },
    "realUserMediaUsed": { "const": false },
    "signedUrlsUsed": { "const": false },
    "shellUsed": { "const": false },
    "arbitraryArgsUsed": { "const": false },
    "workerExecutionPerformed": { "const": false },
    "providerCallsPerformed": { "const": false },
    "supabaseMutationPerformed": { "const": false },
    "sqlExecuted": { "const": false },
    "packageLockMutated": { "const": false },
    "betaProductionUnlocked": { "const": false },
    "mediaProcessingPerformed": { "const": false },
    "metadataProbePerformed": { "type": "boolean" },
    "exitCode": { "type": "number" },
    "signal": { "type": "string" },
    "sanitizedMetadataSummary": {
      "type": "object",
      "required": [
        "streamCount",
        "audioStreamCount",
        "videoStreamCount",
        "codecTypes",
        "probeOutputBytes",
        "metadataShapeValid"
      ],
      "properties": {
        "formatName": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "streamCount": { "type": "number", "minimum": 0 },
        "audioStreamCount": { "type": "number", "minimum": 0 },
        "videoStreamCount": { "type": "number", "const": 0 },
        "codecTypes": { "type": "array", "items": { "type": "string" } },
        "sampleRate": { "type": "number" },
        "channels": { "type": "number" },
        "bitRate": { "type": "number" },
        "probeOutputBytes": { "type": "number", "minimum": 1 },
        "metadataShapeValid": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sanitizedStdoutSummary": { "type": "string" },
    "sanitizedStderrSummary": { "type": "string" },
    "issues": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "tempWorkspaceCreated": { "const": true },
    "tempWorkspaceCleanedUp": { "const": true },
    "executesTools": { "const": true }
  },
  "additionalProperties": false
}
