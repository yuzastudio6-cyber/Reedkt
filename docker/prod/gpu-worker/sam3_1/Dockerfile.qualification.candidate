    "import hashlib; from pathlib import Path; path=Path('/opt/reeditpro/sam3-source/sam3/model_builder.py'); body=path.read_bytes(); assert hashlib.sha256(body).hexdigest() == '8349e6d536e7eb1a233984a971a6c9fb3ccc4034d591b4f8f7946d49327f99bf'; text=body.decode('utf-8'); assert text.count('import os\\n') == 1; assert text.count('import pkg_resources\\n') == 1; text=text.replace('import os\\n', 'import os\\nfrom importlib.resources import files\\n', 1); text=text.replace('import pkg_resources\\n', '', 1); old='        bpe_path = pkg_resources.resource_filename(\\n            \"sam3\", \"assets/bpe_simple_vocab_16e6.txt.gz\"\\n        )'; new='        bpe_path = str(files(\"sam3\").joinpath(\"assets/bpe_simple_vocab_16e6.txt.gz\"))'; assert text.count(old) == 3; text=text.replace(old, new); output=text.encode('utf-8'); assert hashlib.sha256(output).hexdigest() == '9590d6a90c96ad632e7a646ba0e65508bcaf1cfeb0fbc3ad90fcc3f26614b76c'; path.write_bytes(output)" \
