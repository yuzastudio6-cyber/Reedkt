{
  "name": "reeditpro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "npm run typecheck:server && vite build --config vite.server.config.ts",
    "build:remotion-worker:mock": "npm run typecheck:server && vite build --config vite.remotion-worker.config.ts",
    "dev:api": "tsx server/index.ts",
    "typecheck:api": "tsc -p tsconfig.server.json --noEmit",
    "build:api": "npm run typecheck:api",
    "smoke:api": "tsx server/smoke/backend-runtime-smoke.ts",
    "smoke:upload": "tsx server/smoke/upload-storage-smoke.ts",
    "smoke:tools": "tsx server/smoke/tool-readiness-smoke.ts",
    "smoke:worker": "tsx server/smoke/worker-claim-smoke.ts",
    "smoke:prompt6-ready": "tsx server/smoke/prompt6-readiness-smoke.ts",
    "smoke:render": "tsx server/cli/basic-render-smoke.ts",
    "smoke:render:strict": "tsx server/cli/basic-render-smoke.ts --strict",
    "smoke:render:test": "tsx server/smoke/basic-render-smoke-test.ts",
    "smoke:supabase:tables": "tsx server/cli/supabase-table-smoke.ts",
    "smoke:supabase:write": "tsx server/cli/supabase-write-smoke.ts",
    "smoke:e2e:persisted-render": "tsx server/cli/persisted-render-smoke.ts",
    "smoke:supabase:rpcs": "tsx server/cli/supabase-rpc-readiness-smoke.ts",
    "smoke:e2e:rpc-persisted-render": "tsx server/cli/e2e-rpc-persisted-render-smoke.ts",
    "smoke:e2e:local-full": "tsx server/cli/local-full-editing-flow.ts",
    "smoke:e2e:supabase-full": "tsx server/cli/supabase-full-editing-flow.ts",
    "e2e:readiness": "tsx server/cli/e2e-readiness-summary.ts",
    "smoke:supabase:migration-manifest": "tsx server/cli/supabase-migration-manifest-check.ts",
    "supabase:e2e:manifest": "tsx server/cli/supabase-migration-manifest-check.ts",
    "smoke:supabase:live-env": "tsx server/cli/supabase-live-env-check.ts",
    "smoke:supabase:live-migration-status": "tsx server/cli/supabase-live-migration-status.ts",
    "smoke:supabase:rls-auth": "tsx server/cli/supabase-rls-auth-audit.ts",
    "smoke:supabase:readiness:test": "tsx server/smoke/supabase-readiness-smoke.ts",
    "smoke:supabase:write:test": "tsx server/smoke/supabase-write-read-smoke-test.ts",
    "smoke:e2e:persisted-render:test": "tsx server/smoke/persisted-render-smoke-test.ts",
    "smoke:supabase:rpcs:test": "tsx server/smoke/supabase-rpc-readiness-test.ts",
    "smoke:e2e:rpc-persisted-render:test": "tsx server/smoke/e2e-rpc-persisted-render-test.ts",
    "smoke:e2e:local-full:test": "tsx server/smoke/e2e-local-full-flow-test.ts",
    "smoke:e2e:supabase-full:test": "tsx server/smoke/e2e-supabase-full-flow-test.ts",
    "smoke:e2e:readiness:test": "tsx server/smoke/e2e-readiness-summary-test.ts",
    "smoke:supabase:migration-manifest:test": "tsx server/smoke/supabase-migration-manifest-test.ts",
    "smoke:supabase:live-env:test": "tsx server/smoke/supabase-live-env-test.ts",
    "smoke:supabase:rls-auth:test": "tsx server/smoke/supabase-rls-auth-audit-test.ts",
    "smoke:supabase:write-guard:test": "tsx server/smoke/supabase-live-write-guard-test.ts",
    "tools:check": "tsx server/cli/check-tools.ts",
    "tools:summary": "tsx server/cli/e2e-tool-summary.ts",
    "worker:run": "tsx server/cli/run-worker-job.ts",
    "worker:probe-media": "tsx server/cli/probe-media.ts",
    "docker:worker:build": "docker build -f docker/worker/Dockerfile -t reeditpro-worker-dev .",
    "docker:worker:tools": "docker run --rm --env API_ALLOW_MOCK_WITHOUT_SUPABASE=true --env E2E_RUNTIME_MODE=local --env WORKER_RUNTIME_MODE=local reeditpro-worker-dev npm run tools:check",
    "docker:worker:smoke": "docker run --rm --env API_ALLOW_MOCK_WITHOUT_SUPABASE=true --env E2E_RUNTIME_MODE=local --env WORKER_RUNTIME_MODE=local reeditpro-worker-dev npm run smoke:tools",
    "docker:worker:render-smoke": "docker run --rm --env API_ALLOW_MOCK_WITHOUT_SUPABASE=true --env E2E_RUNTIME_MODE=local --env WORKER_RUNTIME_MODE=local --env STORAGE_MODE=local --env STRICT_RENDER_SMOKE=true reeditpro-worker-dev npm run smoke:render",
    "start:server": "node dist-server/server.js",
    "start:remotion-worker:mock": "node dist-remotion-worker/remotion-worker-cli.js",
    "dev:server": "npm run build:server && npm run start:server",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@supabase/supabase-js": "^2.106.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
