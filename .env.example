# Placeholder environment variables for future local development only.
# Do not commit real values, API keys, service role keys, provider secrets, webhook secrets, or signed URLs.
# Real production values belong in Google Secret Manager or secure deployment configuration, not this file.

# Frontend-safe public values only. Vite exposes VITE_* variables to browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never import this into Vite/frontend code and never expose it through VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# Future Google Cloud placeholders. Do not run gcloud or create resources for RP-GCP-00.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=

# Future us-east1 GCS bucket placeholders. Keep blank in this example file.
GCS_US_EAST1_SOURCE_MEDIA_BUCKET=
GCS_US_EAST1_GENERATED_ASSETS_BUCKET=
GCS_US_EAST1_PROCESSED_MEDIA_BUCKET=
GCS_US_EAST1_PREVIEWS_BUCKET=
GCS_US_EAST1_EXPORTS_BUCKET=
GCS_US_EAST1_THUMBNAILS_BUCKET=
GCS_US_EAST1_QA_ARTIFACTS_BUCKET=
GCS_US_EAST1_WORKER_TEMP_BUCKET=

# Future europe-west1 GCS bucket placeholders. Keep blank in this example file.
GCS_EUROPE_WEST1_SOURCE_MEDIA_BUCKET=
GCS_EUROPE_WEST1_GENERATED_ASSETS_BUCKET=
GCS_EUROPE_WEST1_PROCESSED_MEDIA_BUCKET=
GCS_EUROPE_WEST1_PREVIEWS_BUCKET=
GCS_EUROPE_WEST1_EXPORTS_BUCKET=
GCS_EUROPE_WEST1_THUMBNAILS_BUCKET=
GCS_EUROPE_WEST1_QA_ARTIFACTS_BUCKET=
GCS_EUROPE_WEST1_WORKER_TEMP_BUCKET=

# Future Secret Manager reference-name placeholders only. Raw secrets do not belong here.
GOOGLE_SECRET_OPENAI_API_KEY_NAME=
GOOGLE_SECRET_WAN_API_KEY_NAME=
GOOGLE_SECRET_HAILUO_API_KEY_NAME=
GOOGLE_SECRET_VEO_VERTEX_CONFIG_NAME=
GOOGLE_SECRET_LYRIA_API_KEY_NAME=
GOOGLE_SECRET_SUPABASE_SERVICE_ROLE_KEY_NAME=
GOOGLE_SECRET_PROVIDER_WEBHOOK_SIGNING_SECRET_NAME=
GOOGLE_SECRET_STRIPE_WEBHOOK_SECRET_NAME=

# Future local provider placeholders only. Real provider values belong in Secret Manager.
OPENAI_API_KEY=
AI_PROVIDER_WAN_API_KEY=
AI_PROVIDER_HAILUO_API_KEY=
AI_PROVIDER_VEO_VERTEX_CONFIG=
AI_PROVIDER_KLING_API_KEY=

# Lyria remains mock by default. Real calls must run only in secure backend/worker runtime.
LYRIA_INTEGRATION_MODE=mock
LYRIA_MODEL_NAME=lyria-3-pro-preview
LYRIA_OUTPUT_MIME_TYPE=audio/wav

# Future Stripe placeholders only. RP-GCP-00 does not add Stripe integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
