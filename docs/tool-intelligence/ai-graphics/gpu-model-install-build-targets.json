    "opencvPythonPin": "4.10.0.84",
    "opencvPythonHeadlessPin": "4.10.0.84",
    "rembgGpuPin": "2.0.69",
    "reason": "opencv-python/opencv-python-headless 4.12 requires NumPy 2.x on Python 3.10 and conflicts with the pinned CUDA Torch worker stack; rembg 2.0.70+ requires Python 3.11, so the CUDA Ubuntu 22.04 Python 3.10 worker install target uses rembg[gpu] 2.0.69; torchaudio is pinned to the same 2.5.1+cu124 line as torch because Demucs otherwise resolves a newer torchaudio line.",
    "sam2NoBuildIsolationInstall": {
      "appliesTo": "docker/prod/gpu-worker/Dockerfile",
      "torchCudaArchList": "8.9",
      "reason": "SAM2 source wheel build isolation can select a newer Torch/CUDA build stack; the shared worker installs SAM2 with --no-build-isolation after torch==2.5.1+cu124 and torchvision==0.20.1+cu124 are installed. Docker build has no visible NVIDIA device for Torch extension architecture inference, so the install-proof target sets TORCH_CUDA_ARCH_LIST=8.9 for the approved NVIDIA L4 target."
    },
    "sam2PythonDevHeaders": {
      "appliesTo": "docker/prod/gpu-worker/Dockerfile",
      "package": "python3-dev",
      "reason": "The shared GPU worker SAM2 source extension compile includes torch extension headers that require Python.h, so the install-proof target installs python3-dev before the SAM2 no-build-isolation source build."
    },
    "torchvisionFunctionalTensorShim": {
      "appliesTo": [
        "docker/prod/gpu-worker/Dockerfile",
        "docker/prod/real-esrgan-runtime/Dockerfile"
      ],
      "reason": "basicsr 1.4.2 imports torchvision.transforms.functional_tensor.rgb_to_grayscale, which is absent from torchvision 0.20.1; the image adds a narrow compatibility shim that re-exports rgb_to_grayscale from torchvision.transforms.functional."
    },
    "pipDownloadHardening": {
      "timeoutSeconds": 120,
      "retries": 10,
      "reason": "CUDA worker wheels are large enough for transient download timeouts on local buildx or remote builders."
    },
    "appliesTo": [
      "docker/prod/gpu-worker/requirements.gpu.txt",
      "docker/prod/sam2-runtime/requirements.sam2.txt",
      "docker/prod/birefnet-runtime/requirements.birefnet.txt",
      "docker/prod/real-esrgan-runtime/requirements.real-esrgan.txt"
    ]
  },
