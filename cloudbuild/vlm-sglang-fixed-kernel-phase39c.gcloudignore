# Phase 39C-SG-FIXED Cloud Build source bundle.
# Keep this narrow: the kernel-profile image only needs the Dockerfile,
# the SGLang worker runtime files, and this Cloud Build config.

*

!cloudbuild/
!cloudbuild/vlm-sglang-fixed-kernel-phase39c.yaml
!cloudbuild/vlm-sglang-fixed-kernel-phase39c.gcloudignore

!docker/
!docker/prod/
!docker/prod/vlm-sglang-runtime/
!docker/prod/vlm-sglang-runtime/Dockerfile.fixed-kernel

!server/
!server/workers/
!server/workers/vlm-sglang-runtime/
!server/workers/vlm-sglang-runtime/**

**/.git
**/node_modules
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/hf-cache
**/huggingface
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/model-weights
**/models
**/generated-vlm-*
**/activation/phase39*
**/*.log
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*.mp4
**/*.mov
**/*.mkv
**/*.wav
**/*.mp3
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
