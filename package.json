{
  "name": "reeditpro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "npm run typecheck:server && vite build --config vite.server.config.ts",
    "build:remotion-worker:mock": "npm run typecheck:server && vite build --config vite.remotion-worker.config.ts",
    "dev:api": "tsx server/index.ts",
    "typecheck:api": "tsc -p tsconfig.server.json --noEmit",
    "build:api": "npm run typecheck:api",
    "smoke:api": "tsx server/smoke/backend-runtime-smoke.ts",
    "smoke:upload": "tsx server/smoke/upload-storage-smoke.ts",
    "smoke:tools": "tsx server/smoke/tool-readiness-smoke.ts",
    "smoke:worker": "tsx server/smoke/worker-claim-smoke.ts",
    "smoke:prompt6-ready": "tsx server/smoke/prompt6-readiness-smoke.ts",
    "smoke:render": "tsx server/cli/basic-render-smoke.ts",
    "smoke:render:strict": "tsx server/cli/basic-render-smoke.ts --strict",
    "smoke:render:test": "tsx server/smoke/basic-render-smoke-test.ts",
    "tools:check": "tsx server/cli/check-tools.ts",
    "tools:summary": "tsx server/cli/e2e-tool-summary.ts",
    "worker:run": "tsx server/cli/run-worker-job.ts",
    "worker:probe-media": "tsx server/cli/probe-media.ts",
    "docker:worker:build": "docker build -f docker/worker/Dockerfile -t reeditpro-worker-dev .",
    "docker:worker:tools": "docker run --rm --env API_ALLOW_MOCK_WITHOUT_SUPABASE=true --env E2E_RUNTIME_MODE=local --env WORKER_RUNTIME_MODE=local reeditpro-worker-dev npm run tools:check",
    "docker:worker:smoke": "docker run --rm --env API_ALLOW_MOCK_WITHOUT_SUPABASE=true --env E2E_RUNTIME_MODE=local --env WORKER_RUNTIME_MODE=local reeditpro-worker-dev npm run smoke:tools",
    "docker:worker:render-smoke": "docker run --rm --env API_ALLOW_MOCK_WITHOUT_SUPABASE=true --env E2E_RUNTIME_MODE=local --env WORKER_RUNTIME_MODE=local --env STORAGE_MODE=local --env STRICT_RENDER_SMOKE=true reeditpro-worker-dev npm run smoke:render",
    "start:server": "node dist-server/server.js",
    "start:remotion-worker:mock": "node dist-remotion-worker/remotion-worker-cli.js",
    "dev:server": "npm run build:server && npm run start:server",
    "lint": "eslint .",
    "preview": "vite preview",
    "schema:static-audit": "node scripts/validation/supabase-schema-static-audit.mjs",
    "auth:rls:diagnostics": "node scripts/validation/auth-rls-validation-diagnostics.mjs",
    "storage:scope:diagnostics": "node scripts/validation/storage-upload-scope-diagnostics.mjs",
    "snapshot:scope:diagnostics": "node scripts/validation/approved-snapshot-scope-diagnostics.mjs",
    "credit:scope:diagnostics": "node scripts/validation/credit-scope-diagnostics.mjs",
    "backend:api:diagnostics": "node scripts/validation/backend-api-route-scope-diagnostics.mjs",
    "job:worker:diagnostics": "node scripts/validation/job-worker-scope-diagnostics.mjs",
    "media:readiness:diagnostics": "node scripts/validation/media-readiness-scope-diagnostics.mjs",
    "render:export:diagnostics": "node scripts/validation/render-export-scope-diagnostics.mjs",
    "qa:revision:diagnostics": "node scripts/validation/qa-revision-scope-diagnostics.mjs",
    "tool:call:diagnostics": "node scripts/validation/tool-call-scope-diagnostics.mjs",
    "tool:readiness:diagnostics": "node scripts/validation/tool-readiness-worker-runtime-diagnostics.mjs",
    "worker:execution:diagnostics": "node scripts/validation/worker-execution-contract-diagnostics.mjs",
    "provider:gateway:diagnostics": "node scripts/validation/provider-gateway-scope-diagnostics.mjs",
    "compliance:diagnostics": "node scripts/validation/compliance-scope-diagnostics.mjs",
    "observability:diagnostics": "node scripts/validation/observability-scope-diagnostics.mjs",
    "e2e:staging:diagnostics": "node scripts/validation/e2e-staging-smoke-plan-diagnostics.mjs",
    "supabase:rls:prep:diagnostics": "node scripts/validation/supabase-rls-preparation-diagnostics.mjs",
    "staging:supabase:approval:diagnostics": "node scripts/validation/staging-supabase-approval-packet-diagnostics.mjs",
    "staging:supabase:approval-review:diagnostics": "node scripts/validation/staging-supabase-human-approval-review-diagnostics.mjs",
    "staging:supabase:approval-decision:diagnostics": "node scripts/validation/staging-supabase-human-decision-record-diagnostics.mjs",
    "supabase:local:toolchain:probe": "node scripts/validation/local-supabase-host-toolchain-probe.mjs",
    "supabase:local:preflight": "node scripts/validation/local-supabase-safety-preflight.mjs",
    "supabase:rls:list-tests": "node scripts/validation/local-supabase-rls-runner.mjs --list-tests",
    "supabase:rls:local:dry-run": "node scripts/validation/local-supabase-rls-runner.mjs --dry-run",
    "supabase:rls:local:run": "node scripts/validation/local-supabase-rls-runner.mjs --run",
    "foundation:tool-readiness": "tsx server/cli/foundation-tool-readiness.ts",
    "foundation:tool-readiness:report": "tsx server/cli/foundation-tool-readiness-report.ts",
    "smoke:tool-readiness-worker-runtime-foundation": "tsx server/smoke/tool-readiness-worker-runtime-foundation-smoke.ts",
    "foundation:validate": "node scripts/validation/run-foundation-validation.mjs",
    "foundation:validate:with-build": "REEDITPRO_INCLUDE_FULL_BUILD=true node scripts/validation/run-foundation-validation.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@supabase/supabase-js": "^2.106.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
