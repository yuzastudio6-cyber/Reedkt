# Placeholder environment variables for future local development only.
# Do not commit real values, API keys, service role keys, provider secrets, webhook secrets, or signed URLs.
# Real production values belong in Google Secret Manager or secure deployment configuration, not this file.

# Frontend-safe public values only. Vite exposes VITE_* variables to browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ReeditPro API route skeleton. Defaults to local mock until a backend is deployed.
# Do not put backend secrets in VITE variables.
VITE_REEDITPRO_API_BASE_URL=
VITE_REEDITPRO_API_MODE=mock

# Server-only. Never import this into Vite/frontend code and never expose it through VITE_*.
NODE_ENV=development
SERVER_RUNTIME_MODE=mock
PORT=8080
API_PORT=8787
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8787
# ReeditPro currently uses Supabase clients/migrations for PostgreSQL. Keep DATABASE_URL blank unless a future direct Postgres test/runtime path explicitly uses it.
DATABASE_URL=
E2E_RUNTIME_MODE=local
API_ALLOW_MOCK_WITHOUT_SUPABASE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only upload/storage runtime. Local mode is for smoke tests only.
STORAGE_MODE=local
LOCAL_STORAGE_ROOT=.reeditpro-local-storage
SIGNED_URL_TTL_SECONDS=900

# Future Google Cloud placeholders. Do not run gcloud or create resources for RP-GCP-00.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=
GCS_DEFAULT_REGION=us-east1
GCS_SOURCE_MEDIA_BUCKET=
GCS_GENERATED_ASSETS_BUCKET=
GCS_PROCESSED_MEDIA_BUCKET=
GCS_PREVIEWS_BUCKET=
GCS_EXPORTS_BUCKET=
GCS_THUMBNAILS_BUCKET=
GCS_QA_ARTIFACTS_BUCKET=
GCS_WORKER_TEMP_BUCKET=

# Server-only worker runtime readiness. Local mode checks tools only; it does not call providers or render.
WORKER_RUNTIME_MODE=local
WORKER_INSTANCE_ID=local-worker-1
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_CLAIM_LEASE_SECONDS=300
STRICT_TOOL_READINESS=false
STRICT_PROMPT6_TOOL_READINESS=false
STRICT_RENDER_SMOKE=false
TOOL_CHECK_TIMEOUT_MS=10000
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
REMOTION_BIN=npx remotion
PYTHON_BIN=python
PLAYWRIGHT_BIN=npx playwright

# Future us-east1 GCS bucket placeholders. Keep blank in this example file.
GCS_US_EAST1_SOURCE_MEDIA_BUCKET=
GCS_US_EAST1_GENERATED_ASSETS_BUCKET=
GCS_US_EAST1_PROCESSED_MEDIA_BUCKET=
GCS_US_EAST1_PREVIEWS_BUCKET=
GCS_US_EAST1_EXPORTS_BUCKET=
GCS_US_EAST1_THUMBNAILS_BUCKET=
GCS_US_EAST1_QA_ARTIFACTS_BUCKET=
GCS_US_EAST1_WORKER_TEMP_BUCKET=

# Future europe-west1 GCS bucket placeholders. Keep blank in this example file.
GCS_EUROPE_WEST1_SOURCE_MEDIA_BUCKET=
GCS_EUROPE_WEST1_GENERATED_ASSETS_BUCKET=
GCS_EUROPE_WEST1_PROCESSED_MEDIA_BUCKET=
GCS_EUROPE_WEST1_PREVIEWS_BUCKET=
GCS_EUROPE_WEST1_EXPORTS_BUCKET=
GCS_EUROPE_WEST1_THUMBNAILS_BUCKET=
GCS_EUROPE_WEST1_QA_ARTIFACTS_BUCKET=
GCS_EUROPE_WEST1_WORKER_TEMP_BUCKET=

# Future Secret Manager reference-name placeholders only. Raw secrets do not belong here.
GOOGLE_SECRET_OPENAI_API_KEY_NAME=
GOOGLE_SECRET_WAN_API_KEY_NAME=
GOOGLE_SECRET_HAILUO_API_KEY_NAME=
GOOGLE_SECRET_VEO_VERTEX_CONFIG_NAME=
GOOGLE_SECRET_LYRIA_API_KEY_NAME=
GOOGLE_SECRET_SUPABASE_SERVICE_ROLE_KEY_NAME=
GOOGLE_SECRET_PROVIDER_WEBHOOK_SIGNING_SECRET_NAME=
GOOGLE_SECRET_STRIPE_WEBHOOK_SECRET_NAME=

# Future local provider placeholders only. Real provider values belong in Secret Manager.
OPENAI_API_KEY=
AI_PROVIDER_WAN_API_KEY=
AI_PROVIDER_HAILUO_API_KEY=
AI_PROVIDER_VEO_VERTEX_CONFIG=
AI_PROVIDER_KLING_API_KEY=

# Lyria remains mock by default. Real calls must run only in secure backend/worker runtime.
LYRIA_INTEGRATION_MODE=mock
LYRIA_MODEL_NAME=lyria-3-pro-preview
LYRIA_OUTPUT_MIME_TYPE=audio/wav

# SoundSync SFX remains mock by default. Real calls must run only in secure backend/worker runtime.
# Do not commit real provider keys. Real SFX provider calls must run only in secure backend/worker runtime.
# Future production Secret Manager reference names are reeditpro-prod-mirelo-api-key and reeditpro-prod-mmaudio-api-key.
SFX_PROVIDER_INTEGRATION_MODE=mock
MIRELO_SFX_MODEL_NAME=mirelo-sfx-v1.5
MMAUDIO_MODEL_NAME=mmaudio-v2
MIRELO_API_KEY=
MMAUDIO_API_KEY=
GOOGLE_SECRET_MIRELO_API_KEY_NAME=
GOOGLE_SECRET_MMAUDIO_API_KEY_NAME=

# Future Stripe placeholders only. RP-GCP-00 does not add Stripe integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
