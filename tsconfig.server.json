{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "src/server/**/*.ts",
    "src/backend/**/*.ts",
    "src/types/**/*.ts",
    "src/lib/**/*.ts",
    "vite.server.config.ts"
  ]
}
