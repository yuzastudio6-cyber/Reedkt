{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reeditpro.local/schemas/tool-capability-card.schema.v1.json",
  "title": "Reeditpro Tool Capability Study Card",
  "type": "object",
  "required": [
    "schema",
    "displayName",
    "aliases",
    "runtimeResolution",
    "operations",
    "bestFor",
    "notFor",
    "inputArtifacts",
    "outputArtifacts",
    "validators",
    "fallbackToolIds",
    "resourceProfile",
    "qualityProfile",
    "knownFailureModes",
    "professionalEditingUses",
    "readinessNotes",
    "benchmarkPlaceholders",
    "telemetryPlaceholders"
  ],
  "oneOf": [
    {"required": ["toolId"], "not": {"required": ["externalToolId"]}},
    {"required": ["externalToolId"], "not": {"required": ["toolId"]}}
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "reeditpro.toolCapabilityStudyCard.v1"},
    "toolId": {"type": "string"},
    "externalToolId": {"type": "string"},
    "displayName": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "runtimeResolution": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "first_class_production_tool_id",
            "alias_resolved_to_production_tool_id",
            "pending_production_tool_registry_expansion"
          ]
        },
        "runtimeToolId": {"type": "string"},
        "externalToolId": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operationId",
          "supportLevel",
          "bestFor",
          "notFor",
          "inputArtifacts",
          "outputArtifacts",
          "validators",
          "fallbackToolIds",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "operationId": {"type": "string"},
          "supportLevel": {"enum": ["primary", "secondary", "fallback", "validator", "future"]},
          "bestFor": {"type": "array", "items": {"type": "string"}},
          "notFor": {"type": "array", "items": {"type": "string"}},
          "inputArtifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "outputArtifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "validators": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "fallbackToolIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "bestFor": {"type": "array", "items": {"type": "string"}},
    "notFor": {"type": "array", "items": {"type": "string"}},
    "inputArtifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outputArtifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "validators": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fallbackToolIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resourceProfile": {
      "type": "object",
      "required": ["workerType", "gpuRequired", "cpuAllowed", "executionMode"],
      "additionalProperties": false,
      "properties": {
        "workerType": {"type": "string"},
        "gpuRequired": {"type": "boolean"},
        "cpuAllowed": {"type": "boolean"},
        "executionMode": {"type": "string"}
      }
    },
    "qualityProfile": {
      "type": "object",
      "required": ["productionStatus", "adoptionStage", "launchCore", "modelWeightsRequired", "licenseRisk", "commercialUseStatus"],
      "additionalProperties": false,
      "properties": {
        "productionStatus": {"type": "string"},
        "adoptionStage": {"type": "string"},
        "launchCore": {"type": "boolean"},
        "modelWeightsRequired": {"type": "boolean"},
        "licenseRisk": {"type": "string"},
        "commercialUseStatus": {"type": "string"}
      }
    },
    "knownFailureModes": {"type": "array", "items": {"type": "string"}},
    "professionalEditingUses": {"type": "array", "items": {"type": "string"}},
    "readinessNotes": {"type": "array", "items": {"type": "string"}},
    "benchmarkPlaceholders": {"type": "array", "items": {"type": "string"}},
    "telemetryPlaceholders": {"type": "array", "items": {"type": "string"}}
  }
}
