{
  "id": "edit-preferences-route-entrypoint",
  "decision": "saved_edit_preferences_route_ready_for_private_internal_testing",
  "route": "/preferences",
  "legacyRedirect": "/edit-preferences",
  "source": {
    "page": "src/pages/PreferencesPage.tsx",
    "repository": "src/lib/edit-preference-repository.ts",
    "defaults": "src/lib/edit-preferences.ts"
  },
  "fields": [
    "edit_level",
    "workflow_type",
    "cleanup_preference",
    "visual_preference",
    "mood_style",
    "credit_preference",
    "target_platform"
  ],
  "features": [
    "workspace_scoped_saved_defaults",
    "explicit_save_defaults",
    "preserved_failed_save_draft",
    "retry_refresh_discard",
    "unsaved_navigation_guard",
    "immutable_new_edit_creation_baseline",
    "query_gated_internal_testing_details"
  ],
  "sidebarNavigation": {
    "allowed": [
      "Home",
      "Projects",
      "Edit Videos",
      "Edit Preferences"
    ],
    "removedFromPrimarySidebar": [
      "AI Editor",
      "Media Library",
      "Templates",
      "Team",
      "Analytics",
      "Exports",
      "Brand Kit",
      "Settings",
      "Wallet",
      "Upload"
    ],
    "retiredStandaloneRoutes": {
      "/wallet": "/preferences",
      "/brand-kit": "/preferences",
      "/exports": "/projects"
    },
    "context": "Projects routes to /projects and owns project containers. Edit Videos routes to /edit-videos and opens normal exact edits in Edit Chat. Combined-source integration retains Motion Studio as a separate destination/workspace and must not enforce an exact-four-link ceiling."
  },
  "blockedScope": {
    "upload": false,
    "fileBytesRead": false,
    "referenceUrlFetch": false,
    "qwenCall": false,
    "deepseekCall": false,
    "providerCall": false,
    "workerDispatch": false,
    "mediaProcessing": false,
    "renderOrExport": false,
    "creditReservationOrSpend": false,
    "supabaseReadWrite": false,
    "storageSignedUrls": false,
    "sqlOrMigration": false,
    "externalBeta": false,
    "realUserMediaBeta": false,
    "paidProduction": false,
    "productReady": false
  },
  "validation": {
    "required": [
      "smoke:edit-preferences-route-entrypoint",
      "smoke:edit-preference-persistence",
      "smoke:edit-preference-backend-route",
      "smoke:planning-input-safety",
      "edit-preferences-route-entrypoint.spec.ts",
      "preferences-persistence.spec.ts",
      "edit-preferences-current-edit.spec.ts",
      "frontend-typecheck",
      "build",
      "check:frontend-boundary",
      "git diff --check",
      "git diff --cached --check"
    ]
  }
}
