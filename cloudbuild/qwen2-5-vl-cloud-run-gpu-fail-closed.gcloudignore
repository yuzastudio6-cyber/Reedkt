# Qwen2.5-VL fail-closed Cloud Run image build source bundle.
# Keep this intentionally narrow: Dockerfile, requirements, Cloud Build config,
# and the fail-closed service wrapper only. Model weights stay in private GCS.

/*

!/cloudbuild/
cloudbuild/*
!cloudbuild/qwen2-5-vl-cloud-run-gpu-fail-closed.yaml
!cloudbuild/qwen2-5-vl-cloud-run-gpu-fail-closed.gcloudignore

!/docker/
docker/*
!/docker/prod/
docker/prod/*
!/docker/prod/qwen2-5-vl-cloud-run-gpu/
docker/prod/qwen2-5-vl-cloud-run-gpu/*
!docker/prod/qwen2-5-vl-cloud-run-gpu/Dockerfile
!docker/prod/qwen2-5-vl-cloud-run-gpu/Dockerfile.dockerignore
!docker/prod/qwen2-5-vl-cloud-run-gpu/requirements.qwen2-5-vl.txt

!/server/
server/*
!/server/workers/
server/workers/*
!/server/workers/qwen2_5_vl_cloud_run_gpu/
!server/workers/qwen2_5_vl_cloud_run_gpu/**

**/.git
**/.DS_Store
**/node_modules
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/dist
**/dist-*
**/build
**/*.log
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*token*
**/*.mp4
**/*.mov
**/*.mkv
**/*.webm
**/*.wav
**/*.mp3
**/*.aac
**/*.flac
**/*.ogg
**/*.raw
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.tar.gz
**/model-weights
**/models
**/private-artifacts
**/runtime-artifacts
**/generated-*
**/controlled-*
