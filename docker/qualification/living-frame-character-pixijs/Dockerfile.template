FROM __BASE_IMAGE_ID__ AS build
WORKDIR /app
COPY --chown=10001:10001 docker/qualification/living-frame-character-pixijs/browser-operation.ts /qualification/browser-operation.ts
COPY --chown=10001:10001 docker/qualification/living-frame-character-pixijs/build-bundle.mjs /qualification/build-bundle.mjs
RUN node /qualification/build-bundle.mjs

FROM __BASE_IMAGE_ID__ AS runtime
LABEL org.opencontainers.image.title="ReEditPro Living Frame character PixiJS qualification" \
  com.reeditpro.runner.protocol="living-frame-character-pixijs-internal-container-v1" \
  com.reeditpro.runner.base-image-identity-hash="__BASE_IDENTITY_HASH__" \
  com.reeditpro.runner.source-digest="__SOURCE_DIGEST__" \
  com.reeditpro.runner.private-internal-only="true" \
  com.reeditpro.runner.qualification-only="true" \
  com.reeditpro.runner.operation-registered="false" \
  com.reeditpro.runner.product-ready="false" \
  com.reeditpro.runner.external-beta-ready="false" \
  com.reeditpro.runner.production-ready="false"
COPY --from=build --chown=10001:10001 /qualification/browser-operation.bundle.js /app/living-frame-character-pixijs-browser-operation.bundle.js
COPY --chown=10001:10001 docker/qualification/living-frame-character-pixijs/runner.mjs /app/living-frame-character-pixijs-runner.mjs
USER 10001:10001
WORKDIR /app
ENTRYPOINT ["node", "/app/living-frame-character-pixijs-runner.mjs"]
