# Source-complete SAM 3.1 A100/L4 image candidate. This Dockerfile has no
# network install path. It can be built only from the private, canonical
# Cloud Build capsule documented in README.md. The capsule contains this
# frozen repository slice plus `sam31_private_build_input`; it never contains
# the gated checkpoint or a provider token.
# A resulting image is not dispatch-admissible until the separate A100 and L4
# runtime-release qualifications are persisted and reread.

FROM nvidia/cuda@sha256:4b9ed5fa8361736996499f64ecebf25d4ec37ff56e4d11323ccde10aa36e0c43 AS weeditpro-ffmpeg-nvdec-builder

ENV SOURCE_DATE_EPOCH=0 \
  TZ=UTC \
  LANG=C \
  LC_ALL=C

WORKDIR /build

COPY sam31_private_build_input/dependency-closure/ffmpeg/ffmpeg-8.0.3.tar.gz \
  /build/ffmpeg-8.0.3.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/pkgconf-3.0.4.tar.gz \
  /build/pkgconf-3.0.4.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/nv-codec-headers-n12.2.72.0.tar.gz \
  /build/nv-codec-headers-n12.2.72.0.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/ffmpeg-closure-receipt.json \
  /build/ffmpeg-closure-receipt.json

RUN test "$(uname -m)" = x86_64 \
  && for command_name in cc make sha256sum stat tar; do \
       command -v "${command_name}" >/dev/null \
         || { printf 'ERROR: missing FFmpeg builder utility: %s\n' \
           "${command_name}" >&2; exit 127; }; \
     done \
  && printf '%s  %s\n' \
    '5c868087e6a0d4243b97776c16f3bfe1511cc53f15c26c822b393a3289608121' \
    '/build/ffmpeg-8.0.3.tar.gz' | sha256sum --check --strict \
  && test "$(stat --format='%s' /build/ffmpeg-8.0.3.tar.gz)" = '17211188' \
  && printf '%s  %s\n' \
    '67dd778366d1a094f26a9bf5ad0cce1b2e25588420c49a4c9fea6452a6eef829' \
    '/build/pkgconf-3.0.4.tar.gz' | sha256sum --check --strict \
  && test "$(stat --format='%s' /build/pkgconf-3.0.4.tar.gz)" = '611767' \
  && printf '%s  %s\n' \
    'dbeaec433d93b850714760282f1d0992b1254fc3b5a6cb7d76fc1340a1e47563' \
    '/build/nv-codec-headers-n12.2.72.0.tar.gz' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /build/nv-codec-headers-n12.2.72.0.tar.gz)" = '80935' \
  && mkdir --mode=0755 /build/pkgconf /build/nv-codec-headers /build/ffmpeg \
  && tar --extract --gzip --file /build/pkgconf-3.0.4.tar.gz \
    --directory /build/pkgconf --strip-components=1 \
    --no-same-owner --no-same-permissions \
  && cd /build/pkgconf \
  && ./configure \
    --prefix=/opt/weeditpro/pkgconf \
    --disable-shared \
    --enable-static \
  && make -j4 \
  && make install \
  && test "$(/opt/weeditpro/pkgconf/bin/pkgconf --version)" = '3.0.4' \
  && rm -f /opt/weeditpro/pkgconf/bin/pkg-config \
  && ln -s pkgconf /opt/weeditpro/pkgconf/bin/pkg-config \
  && test "$(/opt/weeditpro/pkgconf/bin/pkg-config --version)" = '3.0.4' \
  && tar --extract --gzip \
    --file /build/nv-codec-headers-n12.2.72.0.tar.gz \
    --directory /build/nv-codec-headers --strip-components=1 \
    --no-same-owner --no-same-permissions \
  && make -C /build/nv-codec-headers \
    PREFIX=/opt/weeditpro/ffnvcodec install \
  && tar --extract --gzip --file /build/ffmpeg-8.0.3.tar.gz \
    --directory /build/ffmpeg --strip-components=1 \
    --no-same-owner --no-same-permissions \
  && cd /build/ffmpeg \
  && PATH=/opt/weeditpro/pkgconf/bin:${PATH} \
    PKG_CONFIG=/opt/weeditpro/pkgconf/bin/pkg-config \
    PKG_CONFIG_PATH=/opt/weeditpro/ffnvcodec/lib/pkgconfig \
    ./configure \
      --prefix=/opt/weeditpro/ffmpeg \
      --enable-shared \
      --disable-static \
      --disable-doc \
      --disable-debug \
      --disable-network \
      --disable-autodetect \
      --disable-x86asm \
      --enable-ffnvcodec \
      --enable-nvdec \
      --enable-cuvid \
      --disable-nvenc \
      --disable-libnpp \
      --disable-vulkan \
      --disable-vaapi \
      --disable-vdpau \
      --extra-cflags=-I/opt/weeditpro/ffnvcodec/include \
      --extra-ldflags=-Wl,-rpath,/opt/weeditpro/ffmpeg/lib \
  && grep -Fx '#define CONFIG_GPL 0' config.h \
  && grep -Fx '#define CONFIG_NONFREE 0' config.h \
  && grep -Fx '#define CONFIG_FFNVCODEC 1' config.h \
  && grep -Fx '#define CONFIG_NVDEC 1' config.h \
  && grep -Fx '#define CONFIG_CUVID 1' config.h \
  && make -j4 \
  && make install \
  && LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -version \
    | grep -F 'ffmpeg version 8.0.3' \
  && LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -buildconf \
    | grep -F -- '--enable-cuvid' \
  && ! LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -buildconf \
    | grep -E -- '--enable-(gpl|nonfree|libnpp)' \
  && LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -decoders \
    | grep -E '[[:space:]]h264_cuvid[[:space:]]' \
  && LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -decoders \
    | grep -E '[[:space:]]hevc_cuvid[[:space:]]'

FROM pytorch/pytorch@sha256:b85566342b86d13a67712e9315d40cdc2dad7f8d86df1aff3831f80835edbcca

ARG SAM31_DEPENDENCY_LOCK_SHA256
ARG SAM31_DEPENDENCY_CLOSURE_RECEIPT_SHA256
ARG SAM31_PATCH_APPLICATION_RECEIPT_SHA256
ARG SAM31_PRIVATE_ARTIFACT_BUILD_BINDING_FILE_SHA256
ARG SAM31_SOURCE_CHECKPOINT_QUALIFICATION_HASH
ARG SAM31_SOURCE_CHECKPOINT_COMPATIBILITY_RECEIPT_SHA256
ARG SAM31_CUDA_FORWARD_COMPAT_INGEST_RECEIPT_SHA256

LABEL io.weeditpro.operation.id="tool.sam3_1.segment_and_track_subject.v1" \
  io.weeditpro.product="WeEditPro" \
  io.weeditpro.runtime.qualification="candidate-only" \
  io.reeditpro.compatibility="legacy" \
  io.reeditpro.operation.id="tool.sam3_1.segment_and_track_subject.v1" \
  io.reeditpro.source.revision="96914d2425f90a64f45ca977c2b5165418099543" \
  io.reeditpro.source.archive.sha256="5138f0e396de40a40ef0168c106e089aacbbf1dc7651be2f81c76f89c2f67f2a" \
  io.reeditpro.source.patch.sha256="daf5dfb59dbe6809eb2731b43e13d91b1679c271f0f4af11962236ffe83eb6ca" \
  io.reeditpro.source.patched-tree="f3a58b95a0e460d76e1cf38abff0382a7307f67d" \
  io.reeditpro.source.patched-archive.sha256="b692268f0e295673d5c5cc2fc14e7813847effc5e371e32cb18c1861b4c8adfb" \
  io.reeditpro.checkpoint.revision="daa63191845a41281374e725f4c9e51c7a824460" \
  io.reeditpro.runtime.network="none" \
  io.reeditpro.runtime.gpu.routes="nvidia-a100-80gb-primary,nvidia-l4-fallback" \
  io.reeditpro.runtime.cpu.substantive="forbidden" \
  io.reeditpro.runtime.qualification="candidate-only"

ENV HF_HUB_OFFLINE=1 \
  TRANSFORMERS_OFFLINE=1 \
  PIP_DISABLE_PIP_VERSION_CHECK=1 \
  PIP_NO_INDEX=1 \
  PYTHONNOUSERSITE=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  WEEDITPRO_PYTHON_VENV=/opt/weeditpro/python-venv \
  PATH=/opt/weeditpro/ffmpeg/bin:${PATH} \
  LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib:/usr/local/cuda/lib64 \
  CUDA_MODULE_LOADING=LAZY \
  NVIDIA_VISIBLE_DEVICES=all \
  NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

WORKDIR /opt/reeditpro

COPY --from=weeditpro-ffmpeg-nvdec-builder \
  /opt/weeditpro/ffmpeg/ /opt/weeditpro/ffmpeg/

COPY sam31_private_build_input/source/sam3-96914d2425f90a64f45ca977c2b5165418099543.tar \
  /tmp/sam3-source.tar
COPY sam31_private_build_input/source/sam3-96914d2425f90a64f45ca977c2b5165418099543-reeditpro-gpu-decode.tar \
  /tmp/sam3-patched-source.tar
COPY sam31_private_build_input/source/source-patch-application-receipt.json \
  /opt/reeditpro/sam3_1/source-patch-application-receipt.json
COPY sam31_private_build_input/dependency-closure/requirements.lock.txt \
  /tmp/sam31-requirements.lock.txt
COPY sam31_private_build_input/dependency-closure/wheelhouse/ \
  /tmp/sam31-wheelhouse/
COPY sam31_private_build_input/dependency-closure/dependency-closure-receipt.json \
  /opt/reeditpro/sam3_1/dependency-closure-receipt.json
COPY sam31_private_build_input/dependency-closure/ffmpeg/ffmpeg-8.0.3.tar.gz \
  /opt/reeditpro/sam3_1/ffmpeg-8.0.3.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/pkgconf-3.0.4.tar.gz \
  /opt/reeditpro/sam3_1/pkgconf-3.0.4.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/nv-codec-headers-n12.2.72.0.tar.gz \
  /opt/reeditpro/sam3_1/nv-codec-headers-n12.2.72.0.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/ffmpeg-closure-receipt.json \
  /opt/reeditpro/sam3_1/ffmpeg-closure-receipt.json
COPY sam31_private_build_input/dependency-closure/cuda-forward-compat/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb \
  /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb
COPY sam31_private_build_input/dependency-closure/cuda-forward-compat/cuda-forward-compat-ingest-receipt.json \
  /opt/reeditpro/sam3_1/cuda-forward-compat-ingest-receipt.json
COPY sam31_private_build_input/release-receipts/private-artifact-build-binding.json \
  /opt/reeditpro/sam3_1/private-artifact-build-binding.json
COPY sam31_private_build_input/release-receipts/source-checkpoint-compatibility-receipt.json \
  /opt/reeditpro/sam3_1/source-checkpoint-compatibility-receipt.json

COPY docker/prod/gpu-worker/sam3_1/patches/0001-reeditpro-gpu-decode.patch \
  /tmp/0001-reeditpro-gpu-decode.patch
COPY docker/prod/gpu-worker/sam3_1/runner.py \
  /opt/reeditpro/sam3_1/runner.py
COPY docker/prod/gpu-worker/sam3_1/entrypoint.sh \
  /opt/reeditpro/sam3_1/entrypoint.sh
COPY docker/prod/gpu-worker/sam3_1/source-provenance.lock \
  /opt/reeditpro/sam3_1/source-provenance.lock

RUN test "${SAM31_DEPENDENCY_LOCK_SHA256}" != "" \
  && test "${SAM31_DEPENDENCY_CLOSURE_RECEIPT_SHA256}" != "" \
  && test "${SAM31_PATCH_APPLICATION_RECEIPT_SHA256}" != "" \
  && test "${SAM31_PRIVATE_ARTIFACT_BUILD_BINDING_FILE_SHA256}" != "" \
  && test "${SAM31_SOURCE_CHECKPOINT_QUALIFICATION_HASH}" != "" \
  && test "${SAM31_SOURCE_CHECKPOINT_COMPATIBILITY_RECEIPT_SHA256}" != "" \
  && test "${SAM31_CUDA_FORWARD_COMPAT_INGEST_RECEIPT_SHA256}" != "" \
  && printf '%s  %s\n' \
    '5138f0e396de40a40ef0168c106e089aacbbf1dc7651be2f81c76f89c2f67f2a' \
    '/tmp/sam3-source.tar' | sha256sum --check --strict \
  && test "$(stat --format='%s' /tmp/sam3-source.tar)" = '73605120' \
  && printf '%s  %s\n' \
    'daf5dfb59dbe6809eb2731b43e13d91b1679c271f0f4af11962236ffe83eb6ca' \
    '/tmp/0001-reeditpro-gpu-decode.patch' | sha256sum --check --strict \
  && printf '%s  %s\n' \
    'b692268f0e295673d5c5cc2fc14e7813847effc5e371e32cb18c1861b4c8adfb' \
    '/tmp/sam3-patched-source.tar' | sha256sum --check --strict \
  && test "$(stat --format='%s' /tmp/sam3-patched-source.tar)" = '73605120' \
  && printf '%s  %s\n' \
    "${SAM31_PATCH_APPLICATION_RECEIPT_SHA256}" \
    '/opt/reeditpro/sam3_1/source-patch-application-receipt.json' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    "${SAM31_DEPENDENCY_LOCK_SHA256}" \
    '/tmp/sam31-requirements.lock.txt' | sha256sum --check --strict \
  && printf '%s  %s\n' \
    "${SAM31_DEPENDENCY_CLOSURE_RECEIPT_SHA256}" \
    '/opt/reeditpro/sam3_1/dependency-closure-receipt.json' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    '5c868087e6a0d4243b97776c16f3bfe1511cc53f15c26c822b393a3289608121' \
    '/opt/reeditpro/sam3_1/ffmpeg-8.0.3.tar.gz' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /opt/reeditpro/sam3_1/ffmpeg-8.0.3.tar.gz)" = '17211188' \
  && printf '%s  %s\n' \
    '67dd778366d1a094f26a9bf5ad0cce1b2e25588420c49a4c9fea6452a6eef829' \
    '/opt/reeditpro/sam3_1/pkgconf-3.0.4.tar.gz' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /opt/reeditpro/sam3_1/pkgconf-3.0.4.tar.gz)" = '611767' \
  && printf '%s  %s\n' \
    'dbeaec433d93b850714760282f1d0992b1254fc3b5a6cb7d76fc1340a1e47563' \
    '/opt/reeditpro/sam3_1/nv-codec-headers-n12.2.72.0.tar.gz' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /opt/reeditpro/sam3_1/nv-codec-headers-n12.2.72.0.tar.gz)" = '80935' \
  && python -I -B -c \
    "import hashlib,json,pathlib; root=pathlib.Path('/opt/reeditpro/sam3_1'); closure=json.loads((root/'dependency-closure-receipt.json').read_text()); ffmpeg_path=root/'ffmpeg-closure-receipt.json'; ffmpeg=json.loads(ffmpeg_path.read_text()); assert closure['torchcodecCudaWheelVersion']=='0.10.0+cu128'; assert closure['torchcodecCpuWheelAccepted'] is False; assert closure['ffmpegClosureReceiptSha256']==hashlib.sha256(ffmpeg_path.read_bytes()).hexdigest(); assert closure['pkgconfVersion']=='3.0.4'; assert closure['pkgconfBuiltOfflineFromPinnedSource'] is True; assert ffmpeg['ffmpegVersion']=='8.0.3'; assert ffmpeg['pkgconfVersion']=='3.0.4'; assert ffmpeg['pkgconfBuiltFromSource'] is True; assert ffmpeg['pkgconfLicense']=='ISC'; assert ffmpeg['nvCodecHeadersVersion']=='n12.2.72.0'; assert ffmpeg['ffmpegLicense']=='LGPL-2.1-or-later'; assert ffmpeg['gplComponentsEnabled'] is False; assert ffmpeg['nonfreeComponentsEnabled'] is False; assert ffmpeg['libnppLinkedIntoFfmpeg'] is False; assert ffmpeg['cpuVideoDecodeFallbackAllowed'] is False" \
  && printf '%s  %s\n' \
    "${SAM31_PRIVATE_ARTIFACT_BUILD_BINDING_FILE_SHA256}" \
    '/opt/reeditpro/sam3_1/private-artifact-build-binding.json' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    "${SAM31_SOURCE_CHECKPOINT_COMPATIBILITY_RECEIPT_SHA256}" \
    '/opt/reeditpro/sam3_1/source-checkpoint-compatibility-receipt.json' \
    | sha256sum --check --strict \
  && python -I -B -c \
    "import hashlib,json; p='/opt/reeditpro/sam3_1/source-checkpoint-compatibility-receipt.json'; v=json.load(open(p,encoding='utf-8')); h=v.pop('qualificationHash'); assert h == '${SAM31_SOURCE_CHECKPOINT_QUALIFICATION_HASH}'; assert hashlib.sha256(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()).hexdigest() == h" \
  && printf '%s  %s\n' \
    'e980bf55b8d1f6390f07968df46644c971a52f4e4129067d33d1445fac716893' \
    '/tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb)" = '37945232' \
  && test "$(dpkg-deb --field \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb Package)" \
    = 'cuda-compat-12-8' \
  && test "$(dpkg-deb --field \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb Version)" \
    = '570.211.01-0ubuntu1' \
  && test "$(dpkg-deb --field \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb Architecture)" \
    = 'amd64' \
  && printf '%s  %s\n' \
    "${SAM31_CUDA_FORWARD_COMPAT_INGEST_RECEIPT_SHA256}" \
    '/opt/reeditpro/sam3_1/cuda-forward-compat-ingest-receipt.json' \
    | sha256sum --check --strict \
  && dpkg-deb --extract \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb / \
  && test -r /usr/local/cuda-12.8/compat/libcuda.so.1 \
  && test -r /usr/local/cuda-12.8/compat/libnvidia-nvvm.so.4 \
  && test -r /usr/local/cuda-12.8/compat/libnvidia-ptxjitcompiler.so.1 \
  && mkdir --mode=0755 /opt/reeditpro/sam3-source \
  && tar \
    --extract \
    --file /tmp/sam3-patched-source.tar \
    --directory /opt/reeditpro/sam3-source \
    --strip-components=1 \
    --no-same-owner \
    --no-same-permissions \
  && python -m venv \
    --without-pip \
    --system-site-packages \
    "${WEEDITPRO_PYTHON_VENV}" \
  && test -x "${WEEDITPRO_PYTHON_VENV}/bin/python" \
  && test -d "${WEEDITPRO_PYTHON_VENV}/lib/python3.12/site-packages" \
  && python -m pip install \
    --no-index \
    --no-cache-dir \
    --no-deps \
    --require-hashes \
    --target="${WEEDITPRO_PYTHON_VENV}/lib/python3.12/site-packages" \
    --find-links=/tmp/sam31-wheelhouse \
    --requirement=/tmp/sam31-requirements.lock.txt \
  && python -m pip install \
    --no-index \
    --no-cache-dir \
    --no-deps \
    --no-build-isolation \
    --target="${WEEDITPRO_PYTHON_VENV}/lib/python3.12/site-packages" \
    /opt/reeditpro/sam3-source \
  && "${WEEDITPRO_PYTHON_VENV}/bin/python" -I -B -c \
    "import importlib.metadata as m; import sys; import torch; import torchvision; import torchcodec; import sam3; assert sys.prefix == '/opt/weeditpro/python-venv'; assert sys.base_prefix != sys.prefix; assert sys.version_info[:2] == (3, 12); assert torch.__version__ == '2.10.0+cu128'; assert torchvision.__version__ == '0.25.0'; assert m.version('torchcodec') == '0.10.0+cu128'; assert torch.version.cuda == '12.8'" \
  && ! ldd "${WEEDITPRO_PYTHON_VENV}/lib/python3.12/site-packages/torchcodec/libtorchcodec_core8.so" \
    | grep -F 'not found' \
  && /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -decoders \
    | grep -E '[[:space:]]h264_cuvid[[:space:]]' \
  && /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -decoders \
    | grep -E '[[:space:]]hevc_cuvid[[:space:]]' \
  && "${WEEDITPRO_PYTHON_VENV}/bin/python" -m py_compile \
    /opt/reeditpro/sam3_1/runner.py \
  && test -x /bin/sh \
  && chmod 0555 /opt/reeditpro/sam3_1/runner.py \
  && chmod 0555 /opt/reeditpro/sam3_1/entrypoint.sh \
  && chmod 0444 \
    /opt/reeditpro/sam3_1/source-provenance.lock \
    /opt/reeditpro/sam3_1/source-patch-application-receipt.json \
    /opt/reeditpro/sam3_1/dependency-closure-receipt.json \
    /opt/reeditpro/sam3_1/ffmpeg-8.0.3.tar.gz \
    /opt/reeditpro/sam3_1/pkgconf-3.0.4.tar.gz \
    /opt/reeditpro/sam3_1/nv-codec-headers-n12.2.72.0.tar.gz \
    /opt/reeditpro/sam3_1/ffmpeg-closure-receipt.json \
    /opt/reeditpro/sam3_1/cuda-forward-compat-ingest-receipt.json \
    /opt/reeditpro/sam3_1/private-artifact-build-binding.json \
    /opt/reeditpro/sam3_1/source-checkpoint-compatibility-receipt.json \
  && find /opt/reeditpro/sam3-source \
    -type d -exec chmod 0555 '{}' + \
  && find /opt/reeditpro/sam3-source \
    -type f -exec chmod 0444 '{}' + \
  && find "${WEEDITPRO_PYTHON_VENV}" \
    -type d -exec chmod 0555 '{}' + \
  && find "${WEEDITPRO_PYTHON_VENV}" \
    -type f -exec chmod 0444 '{}' + \
  && find "${WEEDITPRO_PYTHON_VENV}/bin" \
    -type f -exec chmod 0555 '{}' + \
  && rm -rf \
    /tmp/sam3-source.tar \
    /tmp/sam3-patched-source.tar \
    /tmp/0001-reeditpro-gpu-decode.patch \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb \
    /tmp/sam31-requirements.lock.txt \
    /tmp/sam31-wheelhouse

RUN groupadd --gid 65532 reeditpro \
  && useradd \
    --uid 65532 \
    --gid 65532 \
    --no-create-home \
    --home-dir /nonexistent \
    --shell /usr/sbin/nologin \
    reeditpro

USER 65532:65532
WORKDIR /nonexistent

ENTRYPOINT ["/opt/reeditpro/sam3_1/entrypoint.sh"]
