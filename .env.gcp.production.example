# ReeditPro production GCP foundation template.
# Copy this file locally and fill project-specific values before a human runs scripts/gcp/prod/*.sh.
# Do not commit real secrets or set REEDITPRO_CONFIRM_PROD_SETUP=true by default.

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ARTIFACT_REGION=us-central1
GCP_BUCKET_LOCATION=us-central1
REEDITPRO_ENV=production
REEDITPRO_CONFIRM_PROD_SETUP=false

REEDITPRO_API_SERVICE_ACCOUNT=reeditpro-api-sa
REEDITPRO_CPU_WORKER_SERVICE_ACCOUNT=reeditpro-cpu-worker-sa
REEDITPRO_GPU_WORKER_SERVICE_ACCOUNT=reeditpro-gpu-worker-sa
REEDITPRO_RENDER_WORKER_SERVICE_ACCOUNT=reeditpro-render-worker-sa
REEDITPRO_QA_WORKER_SERVICE_ACCOUNT=reeditpro-qa-worker-sa
REEDITPRO_TOOL_READINESS_SERVICE_ACCOUNT=reeditpro-tool-readiness-sa

REEDITPRO_ARTIFACT_REPOSITORY=reeditpro-workers
REEDITPRO_IMAGE_TAG=manual-not-set
