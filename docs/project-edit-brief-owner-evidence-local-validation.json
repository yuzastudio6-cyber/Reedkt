    "each_approved_or_waived_input_has_reviewedAt",
    "each_approved_or_waived_input_has_notes",
    "safety_scan_clean"
  ],
  "safetyFailures": [
    "secret_like_evidence",
    "signed_url_like_evidence",
    "raw_prompt_like_evidence",
    "private_media_or_artifact_like_evidence"
  ],
  "launchBoundary": {
    "externalBetaAllowed": false,
    "realUserMediaBetaAllowed": false,
    "paidProductionAllowed": false
  },
  "nextMilestoneWhenStrictPasses": "RP-EDITBRIEF-16 - Production Persistence Implementation Plan"
