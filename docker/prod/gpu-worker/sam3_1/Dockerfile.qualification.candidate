# Private A100-only SAM 3.1 source/checkpoint qualification candidate.
# It is built from the same offline, generation-bound source/dependency capsule
# as the future runtime image, but it deliberately does not consume or mint the
# source/checkpoint qualification receipt. The gated checkpoint and probe MP4
# are mounted read-only only for one fixed qualification attempt.

FROM nvidia/cuda@sha256:4b9ed5fa8361736996499f64ecebf25d4ec37ff56e4d11323ccde10aa36e0c43 AS weeditpro-ffmpeg-nvdec-builder

ENV SOURCE_DATE_EPOCH=0 \
  TZ=UTC \
  LANG=C \
  LC_ALL=C

WORKDIR /build

COPY sam31_private_build_input/dependency-closure/ffmpeg/ffmpeg-8.0.3.tar.gz \
  /build/ffmpeg-8.0.3.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/pkgconf-3.0.4.tar.gz \
  /build/pkgconf-3.0.4.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/nv-codec-headers-n12.2.72.0.tar.gz \
  /build/nv-codec-headers-n12.2.72.0.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/ffmpeg-closure-receipt.json \
  /build/ffmpeg-closure-receipt.json

RUN test "$(uname -m)" = x86_64 \
  && for command_name in cc make sha256sum stat tar; do \
       command -v "${command_name}" >/dev/null \
         || { printf 'ERROR: missing FFmpeg builder utility: %s\n' \
           "${command_name}" >&2; exit 127; }; \
     done \
  && printf '%s  %s\n' \
    '5c868087e6a0d4243b97776c16f3bfe1511cc53f15c26c822b393a3289608121' \
    '/build/ffmpeg-8.0.3.tar.gz' | sha256sum --check --strict \
  && test "$(stat --format='%s' /build/ffmpeg-8.0.3.tar.gz)" = '17211188' \
  && printf '%s  %s\n' \
    '67dd778366d1a094f26a9bf5ad0cce1b2e25588420c49a4c9fea6452a6eef829' \
    '/build/pkgconf-3.0.4.tar.gz' | sha256sum --check --strict \
  && test "$(stat --format='%s' /build/pkgconf-3.0.4.tar.gz)" = '611767' \
  && printf '%s  %s\n' \
    'dbeaec433d93b850714760282f1d0992b1254fc3b5a6cb7d76fc1340a1e47563' \
    '/build/nv-codec-headers-n12.2.72.0.tar.gz' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /build/nv-codec-headers-n12.2.72.0.tar.gz)" = '80935' \
  && mkdir --mode=0755 /build/pkgconf /build/nv-codec-headers /build/ffmpeg \
  && tar --extract --gzip --file /build/pkgconf-3.0.4.tar.gz \
    --directory /build/pkgconf --strip-components=1 \
    --no-same-owner --no-same-permissions \
  && cd /build/pkgconf \
  && ./configure \
    --prefix=/opt/weeditpro/pkgconf \
    --disable-shared \
    --enable-static \
  && make -j4 \
  && make install \
  && test "$(/opt/weeditpro/pkgconf/bin/pkgconf --version)" = '3.0.4' \
  && rm -f /opt/weeditpro/pkgconf/bin/pkg-config \
  && ln -s pkgconf /opt/weeditpro/pkgconf/bin/pkg-config \
  && test "$(/opt/weeditpro/pkgconf/bin/pkg-config --version)" = '3.0.4' \
  && tar --extract --gzip \
    --file /build/nv-codec-headers-n12.2.72.0.tar.gz \
    --directory /build/nv-codec-headers --strip-components=1 \
    --no-same-owner --no-same-permissions \
  && make -C /build/nv-codec-headers \
    PREFIX=/opt/weeditpro/ffnvcodec install \
  && tar --extract --gzip --file /build/ffmpeg-8.0.3.tar.gz \
    --directory /build/ffmpeg --strip-components=1 \
    --no-same-owner --no-same-permissions \
  && cd /build/ffmpeg \
  && PATH=/opt/weeditpro/pkgconf/bin:${PATH} \
    PKG_CONFIG=/opt/weeditpro/pkgconf/bin/pkg-config \
    PKG_CONFIG_PATH=/opt/weeditpro/ffnvcodec/lib/pkgconfig \
    ./configure \
      --prefix=/opt/weeditpro/ffmpeg \
      --enable-shared \
      --disable-static \
      --disable-doc \
      --disable-debug \
      --disable-network \
      --disable-autodetect \
      --disable-x86asm \
      --enable-ffnvcodec \
      --enable-nvdec \
      --enable-cuvid \
      --disable-nvenc \
      --disable-libnpp \
      --disable-vulkan \
      --disable-vaapi \
      --disable-vdpau \
      --extra-cflags=-I/opt/weeditpro/ffnvcodec/include \
      --extra-ldflags=-Wl,-rpath,/opt/weeditpro/ffmpeg/lib \
  && grep -Fx '#define CONFIG_GPL 0' config.h \
  && grep -Fx '#define CONFIG_NONFREE 0' config.h \
  && grep -Fx '#define CONFIG_FFNVCODEC 1' config.h \
  && grep -Fx '#define CONFIG_NVDEC 1' config.h \
  && grep -Fx '#define CONFIG_CUVID 1' config.h \
  && make -j4 \
  && make install \
  && LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -version \
    | grep -F 'ffmpeg version 8.0.3' \
  && LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -buildconf \
    | grep -F -- '--enable-cuvid' \
  && ! LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -buildconf \
    | grep -E -- '--enable-(gpl|nonfree|libnpp)' \
  && LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -decoders \
    | grep -E '[[:space:]]h264_cuvid[[:space:]]' \
  && LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib \
    /opt/weeditpro/ffmpeg/bin/ffmpeg -hide_banner -decoders \
    | grep -E '[[:space:]]hevc_cuvid[[:space:]]'

FROM pytorch/pytorch@sha256:b85566342b86d13a67712e9315d40cdc2dad7f8d86df1aff3831f80835edbcca

ARG SAM31_DEPENDENCY_LOCK_SHA256
ARG SAM31_DEPENDENCY_CLOSURE_RECEIPT_SHA256
ARG SAM31_DEPENDENCY_WHEEL_MANIFEST_SHA256
ARG SAM31_PATCH_APPLICATION_RECEIPT_SHA256
ARG SAM31_CUDA_FORWARD_COMPAT_INGEST_RECEIPT_SHA256

LABEL io.weeditpro.product="WeEditPro" \
  io.weeditpro.operation.id="tool.sam3_1.segment_and_track_subject.v1" \
  io.weeditpro.runtime.purpose="source-checkpoint-qualification-only" \
  io.weeditpro.runtime.accelerator="nvidia-a100-80gb" \
  io.weeditpro.runtime.network="none" \
  io.weeditpro.runtime.cpu.substantive="forbidden" \
  io.weeditpro.source.revision="96914d2425f90a64f45ca977c2b5165418099543" \
  io.weeditpro.source.archive.sha256="5138f0e396de40a40ef0168c106e089aacbbf1dc7651be2f81c76f89c2f67f2a" \
  io.weeditpro.source.patch.sha256="daf5dfb59dbe6809eb2731b43e13d91b1679c271f0f4af11962236ffe83eb6ca" \
  io.weeditpro.source.importlib-resources-patch.sha256="6ce1e6954069aff28498284f4cd140cd9530a3f236d04bc507c799fe8ea3521f" \
  io.weeditpro.source.multiplex-session-gpu-forwarding-patch.sha256="fb5c047013629d27d7b8f2aecbf8343a402d2e36de3e24dc1be4347f83d9c86b" \
  io.weeditpro.source.patched-archive.sha256="b692268f0e295673d5c5cc2fc14e7813847effc5e371e32cb18c1861b4c8adfb" \
  io.weeditpro.checkpoint.revision="daa63191845a41281374e725f4c9e51c7a824460" \
  io.reeditpro.compatibility="legacy-cloud-coordinate-only"

ENV HF_HUB_OFFLINE=1 \
  TRANSFORMERS_OFFLINE=1 \
  PIP_DISABLE_PIP_VERSION_CHECK=1 \
  PIP_NO_INDEX=1 \
  PYTHONNOUSERSITE=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  WEEDITPRO_PYTHON_VENV=/opt/weeditpro/python-venv \
  PATH=/opt/weeditpro/ffmpeg/bin:${PATH} \
  LD_LIBRARY_PATH=/opt/weeditpro/ffmpeg/lib:/opt/weeditpro/cuda-npp/lib:/usr/local/lib/python3.12/dist-packages/torch/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cuda_nvrtc/lib:/usr/local/cuda/lib64 \
  CUDA_MODULE_LOADING=LAZY \
  NVIDIA_VISIBLE_DEVICES=all \
  NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

WORKDIR /opt/reeditpro

COPY --from=weeditpro-ffmpeg-nvdec-builder \
  /opt/weeditpro/ffmpeg/ /opt/weeditpro/ffmpeg/

COPY sam31_private_build_input/source/sam3-96914d2425f90a64f45ca977c2b5165418099543.tar \
  /opt/reeditpro/sam3_1/qualification-artifacts/sam3-source.tar
COPY sam31_private_build_input/source/sam3-96914d2425f90a64f45ca977c2b5165418099543-reeditpro-gpu-decode.tar \
  /opt/reeditpro/sam3_1/qualification-artifacts/sam3-patched-source.tar
COPY sam31_private_build_input/source/source-patch-application-receipt.json \
  /opt/reeditpro/sam3_1/qualification-artifacts/source-patch-application-receipt.json
COPY sam31_private_build_input/dependency-closure/requirements.lock.txt \
  /opt/reeditpro/sam3_1/qualification-artifacts/requirements.lock.txt
COPY sam31_private_build_input/dependency-closure/wheelhouse/ \
  /tmp/sam31-wheelhouse/
COPY sam31_private_build_input/dependency-closure/dependency-closure-receipt.json \
  /opt/reeditpro/sam3_1/qualification-artifacts/dependency-closure-receipt.json
COPY sam31_private_build_input/dependency-closure/ffmpeg/ffmpeg-8.0.3.tar.gz \
  /opt/reeditpro/sam3_1/qualification-artifacts/ffmpeg-8.0.3.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/pkgconf-3.0.4.tar.gz \
  /opt/reeditpro/sam3_1/qualification-artifacts/pkgconf-3.0.4.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/nv-codec-headers-n12.2.72.0.tar.gz \
  /opt/reeditpro/sam3_1/qualification-artifacts/nv-codec-headers-n12.2.72.0.tar.gz
COPY sam31_private_build_input/dependency-closure/ffmpeg/ffmpeg-closure-receipt.json \
  /opt/reeditpro/sam3_1/qualification-artifacts/ffmpeg-closure-receipt.json
COPY sam31_private_build_input/dependency-closure/cuda-forward-compat/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb \
  /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb
COPY sam31_private_build_input/dependency-closure/cuda-forward-compat/cuda-forward-compat-ingest-receipt.json \
  /opt/reeditpro/sam3_1/qualification-artifacts/cuda-forward-compat-ingest-receipt.json
COPY sam31_private_build_input/dependency-closure/cuda-npp/libnpp-12-8_12.3.3.100-1_amd64.deb \
  /tmp/libnpp-12-8_12.3.3.100-1_amd64.deb
COPY sam31_private_build_input/dependency-closure/cuda-npp/cuda-npp-runtime-receipt.json \
  /opt/reeditpro/sam3_1/qualification-artifacts/cuda-npp-runtime-receipt.json
COPY sam31_private_build_input/dependency-closure/os-security-updates/ \
  /tmp/os-security-updates/
COPY sam31_private_build_input/dependency-closure/os-security-updates/security-update-receipt.json \
  /opt/reeditpro/sam3_1/qualification-artifacts/os-security-update-receipt.json
COPY sam31_private_build_input/dependency-closure/python-ingest/einops/einops-ingest-receipt.json \
  /opt/reeditpro/sam3_1/qualification-artifacts/einops-ingest-receipt.json
COPY sam31_private_build_input/dependency-closure/python-ingest/pycocotools/pycocotools-ingest-receipt.json \
  /opt/reeditpro/sam3_1/qualification-artifacts/pycocotools-ingest-receipt.json
COPY docker/prod/gpu-worker/sam3_1/patches/0001-reeditpro-gpu-decode.patch \
  /opt/reeditpro/sam3_1/qualification-artifacts/0001-reeditpro-gpu-decode.patch
COPY docker/prod/gpu-worker/sam3_1/patches/0002-weeditpro-importlib-resources.patch \
  /opt/reeditpro/sam3_1/qualification-artifacts/0002-weeditpro-importlib-resources.patch
COPY docker/prod/gpu-worker/sam3_1/patches/0003-weeditpro-multiplex-session-gpu-forwarding.patch \
  /opt/reeditpro/sam3_1/qualification-artifacts/0003-weeditpro-multiplex-session-gpu-forwarding.patch
COPY docker/prod/gpu-worker/sam3_1/qualification_runner.py \
  /opt/reeditpro/sam3_1/qualification_runner.py
COPY docker/prod/gpu-worker/sam3_1/qualification_entrypoint.sh \
  /opt/reeditpro/sam3_1/qualification_entrypoint.sh
COPY docker/prod/gpu-worker/sam3_1/source-provenance.lock \
  /opt/reeditpro/sam3_1/source-provenance.lock

RUN test "${SAM31_DEPENDENCY_LOCK_SHA256}" != "" \
  && test "${SAM31_DEPENDENCY_CLOSURE_RECEIPT_SHA256}" != "" \
  && test "${SAM31_DEPENDENCY_WHEEL_MANIFEST_SHA256}" != "" \
  && test "${SAM31_PATCH_APPLICATION_RECEIPT_SHA256}" != "" \
  && test "${SAM31_CUDA_FORWARD_COMPAT_INGEST_RECEIPT_SHA256}" != "" \
  && printf '%s  %s\n' \
    '321b30ad5a1c3783cb3d73ae439f824f6d3874d76a93a62f4a984959b490aa7b' \
    '/tmp/os-security-updates/openssl_3.0.13-0ubuntu3.12_amd64.deb' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    '6a963adb1106fca567d24d4a1e5da0bad25de79ac2564cd1ba846e677e1c951b' \
    '/tmp/os-security-updates/libssl3t64_3.0.13-0ubuntu3.12_amd64.deb' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    '9a5cf7bc8e876ef4498ddf0180b6fafe0e52c2a8da2f06f8bc78c2a6fc92ec58' \
    '/tmp/os-security-updates/libssl-dev_3.0.13-0ubuntu3.12_amd64.deb' \
    | sha256sum --check --strict \
  && dpkg --install \
    /tmp/os-security-updates/libssl3t64_3.0.13-0ubuntu3.12_amd64.deb \
    /tmp/os-security-updates/libssl-dev_3.0.13-0ubuntu3.12_amd64.deb \
    /tmp/os-security-updates/openssl_3.0.13-0ubuntu3.12_amd64.deb \
  && test "$(dpkg-query --showformat='${Version}' --show openssl)" \
    = '3.0.13-0ubuntu3.12' \
  && test "$(dpkg-query --showformat='${Version}' --show libssl3t64)" \
    = '3.0.13-0ubuntu3.12' \
  && printf '%s  %s\n' \
    '5138f0e396de40a40ef0168c106e089aacbbf1dc7651be2f81c76f89c2f67f2a' \
    '/opt/reeditpro/sam3_1/qualification-artifacts/sam3-source.tar' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /opt/reeditpro/sam3_1/qualification-artifacts/sam3-source.tar)" \
    = '73605120' \
  && printf '%s  %s\n' \
    'b692268f0e295673d5c5cc2fc14e7813847effc5e371e32cb18c1861b4c8adfb' \
    '/opt/reeditpro/sam3_1/qualification-artifacts/sam3-patched-source.tar' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /opt/reeditpro/sam3_1/qualification-artifacts/sam3-patched-source.tar)" \
    = '73605120' \
  && printf '%s  %s\n' \
    'daf5dfb59dbe6809eb2731b43e13d91b1679c271f0f4af11962236ffe83eb6ca' \
    '/opt/reeditpro/sam3_1/qualification-artifacts/0001-reeditpro-gpu-decode.patch' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    "${SAM31_PATCH_APPLICATION_RECEIPT_SHA256}" \
    '/opt/reeditpro/sam3_1/qualification-artifacts/source-patch-application-receipt.json' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    "${SAM31_DEPENDENCY_LOCK_SHA256}" \
    '/opt/reeditpro/sam3_1/qualification-artifacts/requirements.lock.txt' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    "${SAM31_DEPENDENCY_CLOSURE_RECEIPT_SHA256}" \
    '/opt/reeditpro/sam3_1/qualification-artifacts/dependency-closure-receipt.json' \
    | sha256sum --check --strict \
  && printf '%s  %s\n' \
    '5c868087e6a0d4243b97776c16f3bfe1511cc53f15c26c822b393a3289608121' \
    '/opt/reeditpro/sam3_1/qualification-artifacts/ffmpeg-8.0.3.tar.gz' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /opt/reeditpro/sam3_1/qualification-artifacts/ffmpeg-8.0.3.tar.gz)" \
    = '17211188' \
  && printf '%s  %s\n' \
    '67dd778366d1a094f26a9bf5ad0cce1b2e25588420c49a4c9fea6452a6eef829' \
    '/opt/reeditpro/sam3_1/qualification-artifacts/pkgconf-3.0.4.tar.gz' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /opt/reeditpro/sam3_1/qualification-artifacts/pkgconf-3.0.4.tar.gz)" \
    = '611767' \
  && printf '%s  %s\n' \
    'dbeaec433d93b850714760282f1d0992b1254fc3b5a6cb7d76fc1340a1e47563' \
    '/opt/reeditpro/sam3_1/qualification-artifacts/nv-codec-headers-n12.2.72.0.tar.gz' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /opt/reeditpro/sam3_1/qualification-artifacts/nv-codec-headers-n12.2.72.0.tar.gz)" \
    = '80935' \
  && python -I -B -c \
    "import hashlib,json,pathlib; root=pathlib.Path('/opt/reeditpro/sam3_1/qualification-artifacts'); closure=json.loads((root/'dependency-closure-receipt.json').read_text()); security_path=root/'os-security-update-receipt.json'; security=json.loads(security_path.read_text()); ffmpeg_path=root/'ffmpeg-closure-receipt.json'; ffmpeg=json.loads(ffmpeg_path.read_text()); npp_path=root/'cuda-npp-runtime-receipt.json'; npp=json.loads(npp_path.read_text()); einops_path=root/'einops-ingest-receipt.json'; einops=json.loads(einops_path.read_text()); pycocotools_path=root/'pycocotools-ingest-receipt.json'; pycocotools=json.loads(pycocotools_path.read_text()); assert closure['torchcodecCudaWheelVersion']=='0.10.0+cu128'; assert closure['torchcodecCpuWheelAccepted'] is False; assert closure['einopsVersion']=='0.8.2'; assert closure['einopsPrivateIngestReceiptSha256']==hashlib.sha256(einops_path.read_bytes()).hexdigest(); assert closure['samCoreUnconditionallyImportsEinops'] is True; assert einops['packageName']=='einops'; assert einops['packageVersion']=='0.8.2'; assert einops['malwareScan']['scanPassed'] is True; assert closure['pycocotoolsVersion']=='2.0.11'; assert closure['pycocotoolsPrivateIngestReceiptSha256']==hashlib.sha256(pycocotools_path.read_bytes()).hexdigest(); assert closure['samCoreUnconditionallyImportsPycocotools'] is True; assert pycocotools['packageName']=='pycocotools'; assert pycocotools['packageVersion']=='2.0.11'; assert pycocotools['nativeExtensionImportVerified'] is True; assert pycocotools['malwareScan']['scanPassed'] is True; assert closure['osSecurityUpdateClosureSha256']==hashlib.sha256(security_path.read_bytes()).hexdigest(); assert closure['opensslVersion']=='3.0.13-0ubuntu3.12'; assert security['source']=='official_ubuntu_noble_security_repository'; assert security['offlineInstallRequired'] is True; assert closure['ffmpegClosureReceiptSha256']==hashlib.sha256(ffmpeg_path.read_bytes()).hexdigest(); assert closure['pkgconfVersion']=='3.0.4'; assert closure['pkgconfBuiltOfflineFromPinnedSource'] is True; assert closure['cudaNppRuntimeReceiptSha256']==hashlib.sha256(npp_path.read_bytes()).hexdigest(); assert closure['cudaNppPackageName']=='libnpp-12-8'; assert closure['cudaNppPackageVersion']=='12.3.3.100-1'; assert closure['torchcodecExactNppRuntimeClosureRequired'] is True; assert closure['completeCudaToolkitCopied'] is False; assert npp['torchcodecCudaWheelVersion']=='0.10.0+cu128'; assert npp['exactTorchcodecElfNeededClosure'] is True; assert npp['completeCudaToolkitCopied'] is False; assert npp['cpuVideoDecodeFallbackAllowed'] is False; assert ffmpeg['ffmpegVersion']=='8.0.3'; assert ffmpeg['pkgconfVersion']=='3.0.4'; assert ffmpeg['pkgconfBuiltFromSource'] is True; assert ffmpeg['pkgconfLicense']=='ISC'; assert ffmpeg['nvCodecHeadersVersion']=='n12.2.72.0'; assert ffmpeg['ffmpegLicense']=='LGPL-2.1-or-later'; assert ffmpeg['gplComponentsEnabled'] is False; assert ffmpeg['nonfreeComponentsEnabled'] is False; assert ffmpeg['libnppLinkedIntoFfmpeg'] is False; assert ffmpeg['cpuVideoDecodeFallbackAllowed'] is False" \
  && printf '%s\n' "${SAM31_DEPENDENCY_WHEEL_MANIFEST_SHA256}" \
    > /opt/reeditpro/sam3_1/qualification-artifacts/wheel-manifest.sha256 \
  && printf '%s  %s\n' \
    'e980bf55b8d1f6390f07968df46644c971a52f4e4129067d33d1445fac716893' \
    '/tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb)" = '37945232' \
  && test "$(dpkg-deb --field \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb Package)" \
    = 'cuda-compat-12-8' \
  && test "$(dpkg-deb --field \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb Version)" \
    = '570.211.01-0ubuntu1' \
  && test "$(dpkg-deb --field \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb Architecture)" \
    = 'amd64' \
  && printf '%s  %s\n' \
    "${SAM31_CUDA_FORWARD_COMPAT_INGEST_RECEIPT_SHA256}" \
    '/opt/reeditpro/sam3_1/qualification-artifacts/cuda-forward-compat-ingest-receipt.json' \
    | sha256sum --check --strict \
  && dpkg-deb --extract \
    /tmp/cuda-compat-12-8_570.211.01-0ubuntu1_amd64.deb / \
  && test -r /usr/local/cuda-12.8/compat/libcuda.so.1 \
  && printf '%s  %s\n' \
    '54febea3b7a793e65318647c0548c0fea2416ef0a7dc70c672c6877f3bcba992' \
    '/tmp/libnpp-12-8_12.3.3.100-1_amd64.deb' \
    | sha256sum --check --strict \
  && test "$(stat --format='%s' \
    /tmp/libnpp-12-8_12.3.3.100-1_amd64.deb)" = '131485608' \
